<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Monk Mode is a dark launcher — use Theme.Black regardless of system dark-mode
         so the cold-start window matches the black home wallpaper and there's no
         white flash between the OS handoff and Flutter's first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
